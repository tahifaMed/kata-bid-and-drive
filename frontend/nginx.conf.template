server {
    # Railway sets PORT at runtime
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Railway private DNS. Resolved at request time, so nginx starts even if the backend is still deploying.
    resolver [fd12::10] valid=10s ipv6=on;

    # Same origin as the app, so the browser needs no CORS. BACKEND_URL is set per service.
    location /api/ {
        set $backend_upstream ${BACKEND_URL};
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # History-mode router: unknown paths fall back to the SPA entry point
    location / {
        try_files $uri $uri/ /index.html;
    }
}
